# Copy to .env and fill in. Used by docker compose and by the backend in local dev.

# Required by SEC: identify your app and give a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="MyFinanceApp ethan.li@tufts.edu"

# Only needed when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# How long cached data stays fresh before it's re-fetched on request.
FUNDAMENTALS_TTL_HOURS=24
PRICES_TTL_HOURS=6
